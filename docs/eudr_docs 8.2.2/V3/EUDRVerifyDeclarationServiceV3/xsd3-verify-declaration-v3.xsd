<?xml version='1.0' encoding='UTF-8'?><!-- Published by JAX-WS RI (https://github.com/eclipse-ee4j/metro-jax-ws). RI's version is JAX-WS RI 3.0.2 git-revision#91dd558. --><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:eudrCommon="http://ec.europa.eu/tracesnt/certificate/eudr/common/v3" xmlns:error="http://ec.europa.eu/sanco/tracesnt/error/v01" xmlns:verify="http://ec.europa.eu/tracesnt/certificate/eudr/verify-declaration/v3" targetNamespace="http://ec.europa.eu/tracesnt/certificate/eudr/verify-declaration/v3" elementFormDefault="qualified">

	<xs:import schemaLocation="https://acceptance.eudr.webcloud.ec.europa.eu:443/tracesnt/ws/EUDRVerifyDeclarationServiceV3?xsd=2" namespace="http://ec.europa.eu/tracesnt/certificate/eudr/common/v3"/>
	<xs:import schemaLocation="https://acceptance.eudr.webcloud.ec.europa.eu:443/tracesnt/ws/EUDRVerifyDeclarationServiceV3?xsd=4" namespace="http://ec.europa.eu/sanco/tracesnt/error/v01"/>

	<!-- Elements for WSDL message parts -->

	<xs:element name="VerifyDeclarationRequest" type="verify:VerifyDeclarationRequestType"/>
	<xs:element name="VerifyDeclarationResponse" type="verify:VerifyDeclarationResponseType"/>

	<xs:element name="BusinessRulesValidationException" type="error:BusinessRulesValidationExceptionType"/>
	<xs:element name="PermissionDeniedException" type="error:CertificatePermissionDeniedExceptionType"/>

	<!-- Request / Response types -->

	<xs:complexType name="VerifyDeclarationRequestType">
		<xs:annotation>
			<xs:documentation>
				Verify declaration request by providing reference number and verification number as input parameter.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="referenceNumber" type="eudrCommon:ReferenceNumberType"/>
			<xs:element name="verificationNumber" type="eudrCommon:VerificationNumberType"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="VerifyDeclarationResponseType">
		<xs:annotation>
			<xs:documentation>
				Verify declaration response is the same for all user roles, including SME downstream operators. Three possible outcomes: (1)
				exists and is usable, (2) exists but is not usable, (3) not found.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="result" type="verify:VerifyResultType"/>
			<xs:element name="status" type="eudrCommon:EudrStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						The declaration lifecycle status. This element is populated only when the result is not NON_EXISTENT;
						for a NON_EXISTENT result no status is returned.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dateTime" type="xs:dateTime"/>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="VerifyResultType">
		<xs:annotation>
			<xs:documentation>
				Verify declaration result type.
                EXISTING_USABLE : The declaration exists and is in a usable status.
                EXISTING_NON_USABLE : The declaration exists but is not usable. (e.g.: it was withdrawn, canceled, rejected...)
				NON_EXISTENT : No declaration matches the provided reference number and verification number combination.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EXISTING_USABLE">
				<xs:annotation>
					<xs:documentation>The declaration exists and is in a usable status. The status element carries the declaration lifecycle status.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXISTING_NON_USABLE">
				<xs:annotation>
					<xs:documentation>The declaration exists but is not usable (e.g. it was withdrawn, cancelled or rejected). The status element carries the declaration lifecycle status.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_EXISTENT">
				<xs:annotation>
					<xs:documentation>No declaration matches the provided reference number and verification number combination. The status element is not populated for this result.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

</xs:schema>